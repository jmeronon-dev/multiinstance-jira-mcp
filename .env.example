# Copy to .env only for local development with `npm run dev`; the server itself
# reads environment variables, it does not load .env files. In real use, put
# these in your MCP client's "env" block or pass them as CLI flags.

# --- Single instance -------------------------------------------------------
# JIRA_BASE_URL=https://acme.atlassian.net
# JIRA_EMAIL=me@acme.com
# JIRA_API_TOKEN=

# --- Several instances -----------------------------------------------------
# JIRA_INSTANCES=cloud,corp,partner
# JIRA_DEFAULT_INSTANCE=cloud
#
# JIRA_CLOUD_URL=https://acme.atlassian.net
# JIRA_CLOUD_EMAIL=me@acme.com
# JIRA_CLOUD_API_TOKEN=
# JIRA_CLOUD_PROJECTS=WEB,APP
#
# JIRA_CORP_URL=https://jira.corp.local/jira
# JIRA_CORP_PAT=
# JIRA_CORP_PROJECTS=OPS,INFRA
#
# JIRA_PARTNER_URL=https://jira.partner.com
# JIRA_PARTNER_AUTH=browser
# JIRA_PARTNER_READ_ONLY=true

# --- Global ---------------------------------------------------------------
# JIRA_MCP_HOME=~/.multiinstance-jira-mcp
# JIRA_MCP_CONFIG=~/.multiinstance-jira-mcp/config.json
# JIRA_READ_ONLY=false
# JIRA_LOGIN_TIMEOUT_SECONDS=300
# JIRA_BROWSER_CHANNEL=chrome
# JIRA_KEEPALIVE_SECONDS=300
# JIRA_MAX_ATTACHMENT_BYTES=20971520
# JIRA_MCP_LOG_LEVEL=info
