{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "jira": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "multiinstance-jira-mcp",
        "--config",
        "~/.multiinstance-jira-mcp/config.json"
      ],
      "enabled": true,
      "environment": {
        "JIRA_CLOUD_TOKEN": "<ATLASSIAN_API_TOKEN>",
        "JIRA_CORP_PAT": "<DATA_CENTER_PAT>"
      }
    }
  }
}
