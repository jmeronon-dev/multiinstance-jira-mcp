{
  "name": "multiinstance-jira-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Jira with first-class multi-instance support: connect 1..N Jira Cloud / Data Center sites at once using API tokens, personal access tokens or browser SSO.",
  "type": "module",
  "bin": {
    "multiinstance-jira-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "install-browser": "playwright install chromium",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "docs:lint": "npx --yes markdownlint-cli2@0.24.0",
    "docs:links": "node scripts/check-markdown-links.mjs",
    "factory:test": "bash .github/scripts/lights-out-guard.test.sh",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jira",
    "jira-cloud",
    "jira-data-center",
    "atlassian",
    "multi-instance",
    "sso",
    "api-token",
    "claude",
    "cursor",
    "copilot"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright": "^1.65.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
